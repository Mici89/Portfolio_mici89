APP_ENV=development
APP_NAME=AI Database Agent API
APP_VERSION=0.1.0
LOG_LEVEL=INFO

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=legacy_enterprise
DB_SCHEMA=
DB_USER=ai_reader
DB_PASSWORD=replace_me
DB_WRITE_USER=ai_writer
DB_WRITE_PASSWORD=replace_me
DB_CONNECT_TIMEOUT_SECONDS=5
DATABASE_ACTION_MAX_AFFECTED_ROWS=100
DATABASE_QUERY_MAX_ATTEMPTS=3
QUERY_GRAPH_CHECKPOINT_PATH=./data/checkpoints/query_graph.sqlite
DATABASE_ACTION_MAX_PLANNING_ROUNDS=3

AUTH_OPERATOR_USERNAME=db_operator
AUTH_OPERATOR_PASSWORD=replace_me
AUTH_TOKEN_SECRET=replace_with_a_long_random_value
AUTH_TOKEN_TTL_MINUTES=480
UNDERSTANDING_MAX_EVIDENCE_ROUNDS=3

DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=90
